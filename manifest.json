{
  "manifest_version": 3,
  "name": "Mergefetti",
  "version": "1.0.0",
  "description": "Celebrates GitHub PR merges with a beautiful, custom confetti rain!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*",
        "https://github.*.com/*"
      ],
      "js": ["canvas-confetti.js", "content.js"]
    }
  ]
}