{
  "manifest_version": 3,
  "name": "Mergefetti",
  "version": "1.1.0",
  "description": "Celebrates GitHub PR merges with a beautiful, custom confetti rain!",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["canvas-confetti.js", "content.js"]
    }
  ]
}
